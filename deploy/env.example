# 云端服务器配置。复制到与 compose.yaml 同目录的 .env 里填写。
# 分层规则：必填的在前，需要改的在前，有默认值的靠后。
#
# 注意：这里不写代理。云端直连 v2ex.com，飞书始终直连。
# 把 HTTPS_PROXY 指向本机地址（127.0.0.1 / host.docker.internal）是最常见的翻车原因。


# ===========================================================================
# 1. 必填（不填服务跑不起来）
# ===========================================================================

# 飞书自定义机器人 webhook：
# https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_WEBHOOK=

# 只有在机器人开启「签名校验」时才需要填写。
FEISHU_SECRET=


# ===========================================================================
# 2. 凭据（需要你填写；填了才启用对应功能）
# ===========================================================================

# V2EX 签到：网页 /mission/daily 只认会话 Cookie，不认同名的 API Token。
# 登录 v2ex.com 后 F12 -> Application -> Cookies -> https://www.v2ex.com，
# 复制 A2 的值（开了 2FA 还要连 A2O 一起）：
#   V2EX_COOKIE=A2=...; A2O=...
# V2EX_COOKIE=

# 2libra 签到：登录后 F12 -> Network -> 请求头 cookie，取 access_token 的值；
# 也可直接填 token 本身（不带 = 和 ; 时按 Authorization: Bearer 发送）。
#   LIBRA_COOKIE=access_token=...
# LIBRA_COOKIE=

# V2EX 提醒（可选）：只用于拉取提醒（API 2.0）。留空则只跑签到。
# 申请地址：https://www.v2ex.com/settings/tokens
V2EX_TOKEN=


# ===========================================================================
# 3. 默认即可（有合理默认值，按需修改）
# ===========================================================================

# 每日签到时间（24 小时制），以及调度使用的时区。
# CHECKIN_TIME=06:00
# TZ=Asia/Shanghai

# 启动时补签（今天还没签就补；同一天重启会跳过），默认 true。
# CHECKIN_ON_START=true

# 轮询间隔，60s 约消耗 600 次/小时配额中的 60 次。
V2EX_POLL_INTERVAL=60s

# 首次运行策略：skip = 只记录已有提醒不推送（推荐）；push = 全部推送。
V2EX_FIRST_RUN=skip

# 推送成功后删除该条 V2EX 提醒。
V2EX_MARK_READ=false

# 只推送这些类型：reply,mention,thanks,other。留空 = 全部推送。
V2EX_FILTER_TYPES=

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
