# Cloud server configuration. Copy to .env in the same directory as compose.yaml.
# Layered: the check-in core comes first, the optional V2EX reminder part after.
#
# NOTE: no proxy variables here. A cloud VM reaches v2ex.com directly, and the
# Feishu client always bypasses proxies. Adding HTTPS_PROXY pointing at a
# local-machine address (127.0.0.1 / host.docker.internal) is the most common
# way to break this deployment.


# ===========================================================================
# 1. Daily check-in  (V2EX + 2libra)  <- the core, fill these first
# ===========================================================================
# A site activates with its credential.
#
# V2EX 每日登录奖励 is a web page that needs the session cookie, not an API
# token. Log in, then F12 -> Application -> Cookies -> www.v2ex.com and copy
# A2 (plus A2O when 2FA is enabled):
#   V2EX_COOKIE=A2=...; A2O=...
#
# 2libra: paste the access_token cookie, or the raw token
# (no '=' -> sent as Authorization: Bearer):
#   LIBRA_COOKIE=access_token=...
#
# V2EX_COOKIE=
# LIBRA_COOKIE=

# Local wall-clock time of the daily run.
# CHECKIN_TIME=06:00

# Time zone for the schedule and timestamps.
# TZ=Asia/Shanghai

# Catch-up on startup when today's run was missed (default true).
# CHECKIN_ON_START=true


# ===========================================================================
# 2. Feishu  (required - both reminders and check-in cards go here)
# ===========================================================================

# Feishu custom bot webhook:
# https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_WEBHOOK=

# Only needed when the bot has signature verification enabled.
FEISHU_SECRET=


# ===========================================================================
# 3. V2EX reminders  (optional - skip this block for check-in only)
# ===========================================================================
# V2EX Personal Access Token - https://www.v2ex.com/settings/tokens
# Only used for the notification reminders (API 2.0). Leave empty to run the
# daily check-in only; the check-in uses V2EX_COOKIE above instead.
V2EX_TOKEN=

# How often to poll. 60s uses ~60 of the 600 req/hour budget.
V2EX_POLL_INTERVAL=60s

# skip = first run records existing notifications without pushing (recommended
# for a fresh volume, so deploying does not flood the group).
V2EX_FIRST_RUN=skip

# Delete the notification on V2EX after a successful push.
V2EX_MARK_READ=false

# Only push these kinds: reply, mention, thanks, other. Empty = push all.
V2EX_FILTER_TYPES=


# ===========================================================================
# 4. Operations
# ===========================================================================

LOG_LEVEL=info
