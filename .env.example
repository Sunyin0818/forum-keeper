# 复制为 .env 后填写。分层规则：必填的在前，需要改的在前，有默认值的靠后。
#
# ⚠️ 不要用 `cp .env.example .env`——会静默覆盖已有的 .env。
#    请用 `./scripts/init-env.sh`（已存在则拒绝覆盖，权限 0600）。
#
# 本文件只是模板，可以安全提交；真正的 .env 已被 .gitignore 忽略。
#
# 命名规则：同一模块共用前缀
#   V2EX_*    V2EX API 与签到网页
#   LIBRA_*   2libra
#   FEISHU_*  飞书机器人
#   CHECKIN_* 签到调度
#   NOTIFY_*  通知行为
#   HTTP_ / STATE_ / LOG_ / TZ  通用运维


# ===========================================================================
# 1. 必填（不填服务跑不起来）
# ===========================================================================

# 飞书自定义机器人 webhook，形如：
# https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_WEBHOOK=

# 只有在机器人开启「签名校验」时才需要填写。
FEISHU_SECRET=


# ===========================================================================
# 2. 凭据（需要你填写；填了才启用对应功能）
# ===========================================================================

# --- V2EX 签到 -----------------------------------------------------------------
# 注意：签到走的是网页 /mission/daily，只认浏览器会话 Cookie，不认下面的 API Token。
# 登录 v2ex.com 后：F12 -> Application -> Cookies -> https://www.v2ex.com
# 复制 A2 的值；开了 2FA 还要连 A2O 一起，拼成：
#   V2EX_COOKIE=A2=...; A2O=...
# 签到卡片提示「Cookie 已失效」时，重新获取并替换这一行。
V2EX_COOKIE=

# --- 2libra 签到 ---------------------------------------------------------------
# 登录 2libra.com 后：F12 -> Network -> 任一请求 -> 请求头 cookie，
# 取 access_token 的值，拼成 access_token=...；也可以直接填 token 本身
# （不带 = 和 ; 时按 Authorization: Bearer 发送）。
#   LIBRA_COOKIE=access_token=...
#   # 或者：LIBRA_COOKIE=eyJhbGciOi...
LIBRA_COOKIE=

# --- V2EX 提醒（可选）----------------------------------------------------------
# 只用于拉取提醒（API 2.0）。V2EX 的两套认证互不通用：
#   * API 2.0（GET /api/v2/notifications）认下面这个 Personal Access Token
#   * 网页（GET /mission/daily）认上面的 V2EX_COOKIE
# Token 访问签到页会被 302 到 /signin，所以签到必须用 Cookie。
#
# 留空则只跑签到、不轮询提醒。申请地址：https://www.v2ex.com/settings/tokens
V2EX_TOKEN=


# ===========================================================================
# 3. 默认即可（有合理默认值，按需修改）
# ===========================================================================

# --- 签到调度 -----------------------------------------------------------------
# 每日签到时间（24 小时制 HH:MM）。
CHECKIN_TIME=06:00

# 启动时补签：今天还没签就直接签（服务在 CHECKIN_TIME 期间重启/宕机也不会漏签）；
# 同一天重启会跳过，不会重复推送。设为 false 则只等 CHECKIN_TIME。
CHECKIN_ON_START=true

# 时区；调度时间和卡片/日志时间戳都用它。
TZ=Asia/Shanghai

# --- V2EX 提醒 -----------------------------------------------------------------
# 轮询间隔，最小 5s。60s 约消耗 600 次/小时配额中的 60 次。
V2EX_POLL_INTERVAL=60s

# 首次运行策略：skip = 只记录已有提醒不推送（推荐，避免刷屏）；push = 全部推送。
V2EX_FIRST_RUN=skip

# 推送成功后删除 V2EX 的提醒。
V2EX_MARK_READ=false

# 只推送这些类型：reply,mention,thanks,other。留空 = 全部推送。
V2EX_FILTER_TYPES=

# 每轮最多翻几页提醒（每页 20 条）。
V2EX_MAX_PAGES=3

# --- 通知行为 -----------------------------------------------------------------
# 启动时发送「服务已启动」卡片。
NOTIFY_STARTUP=true

# 两条启动消息的最小间隔，防止重启循环刷屏；设为 0 则每次都发。
NOTIFY_STARTUP_COOLDOWN=10m

# 连续失败达到阈值时发送飞书告警。
NOTIFY_ALERT_ON_ERROR=true

# --- 运维 --------------------------------------------------------------------
# 单次 HTTP 请求超时。
HTTP_TIMEOUT=20s

# 状态数据库位置。本地运行可留空（默认当前目录 state.db）；
# 容器内由 compose.yaml 覆盖为 /data/state.db。
# STATE_PATH=/data/state.db

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# --- 网络代理（按运行环境决定）-------------------------------------------------
# v2ex.com 在部分网络不可达（DNS 被污染），而 open.feishu.cn 需要直连。
# 代理只对 V2EX 与签到请求生效，飞书始终直连。
#
# 本地容器跑 Clash -> 取消注释，地址要写宿主机（容器内的 127.0.0.1 是容器自己）：
#   docker 用 host.docker.internal，podman 用 host.containers.internal
# 云端服务器直连 v2ex.com -> 不要设置。
#
# 宿主机直接跑（./scripts/dry-run.sh、make run）时，scripts/local-env.sh 会自动把
# host.docker.internal 改写成 127.0.0.1。
#
# HTTPS_PROXY=http://host.docker.internal:7897
# NO_PROXY=localhost,127.0.0.1


# ===========================================================================
# 4. 高级（默认指向公网站点，一般不用改）
# ===========================================================================
# 仅自建镜像或测试时需要。
#
# V2EX_API_BASE_URL=https://www.v2ex.com/api/v2
# V2EX_WEB_BASE_URL=https://www.v2ex.com
# LIBRA_BASE_URL=https://2libra.com
