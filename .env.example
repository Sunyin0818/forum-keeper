# Copy to .env and fill in. Layered: the things you must change come first.
#
# ⚠️ Do not `cp .env.example .env` - it would silently overwrite an existing
#    .env. Use `./scripts/init-env.sh` instead (refuses to overwrite, mode 0600).
#
# This template is safe to commit; the real .env is gitignored.
#
# Naming: everything under a subsystem shares its prefix -
#   V2EX_*    the V2EX API and daily mission
#   LIBRA_*   2libra
#   FEISHU_*  the Feishu bot
#   CHECKIN_* the daily check-in scheduler
#   NOTIFY_*  notification behaviour
#   HTTP_/STATE_/LOG_/TZ  generic operations


# ===========================================================================
# 1. Required
# ===========================================================================

# Personal Access Token from https://www.v2ex.com/settings/tokens
V2EX_TOKEN=

# Feishu custom bot webhook, e.g.
# https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_WEBHOOK=

# Bot signature secret. Leave empty only when signature verification is off.
FEISHU_SECRET=


# ===========================================================================
# 2. Daily check-in  (V2EX + 2libra)
# ===========================================================================
# A site turns on as soon as its credential is present; there is no enable
# switch - clear the line to disable that site.
#
# V2EX 每日登录奖励 is a web page that authenticates with the session cookie,
# NOT the API token above. Log in at https://www.v2ex.com/, then
#   F12 -> Application -> Cookies -> https://www.v2ex.com
# copy A2 (and A2O too if 2FA is enabled):
#   V2EX_COOKIE=A2=...; A2O=...
#
# 2libra signs in with POST /api/sign. Paste either the cookie or the raw
# token; a value without '=' or ';' is sent as Authorization: Bearer.
#   LIBRA_COOKIE=access_token=...
#   # or: LIBRA_COOKIE=eyJhbGciOi...
V2EX_COOKIE=
LIBRA_COOKIE=

# Local wall-clock time of the daily run.
CHECKIN_TIME=06:00

# Catch-up on startup: if today's check-in has not happened yet (the service
# was down or restarting across CHECKIN_TIME), run it right away. A restart
# later the same day is skipped, so a restart loop cannot spam the group.
CHECKIN_ON_START=true

# Time zone for the schedule and all timestamps (IANA name).
TZ=Asia/Shanghai


# ===========================================================================
# 3. V2EX notifications
# ===========================================================================

# How often to poll. Must be >= 5s. 60s uses ~60 of the 600 req/hour budget.
V2EX_POLL_INTERVAL=60s

# skip = record existing notifications on first run without pushing (recommended)
# push = push everything on first run
V2EX_FIRST_RUN=skip

# Delete notifications on V2EX after a successful push.
V2EX_MARK_READ=false

# Only push these kinds: reply, mention, thanks, other. Empty = push all.
V2EX_FILTER_TYPES=

# Number of notification pages to walk per poll (20 entries each).
V2EX_MAX_PAGES=3


# ===========================================================================
# 4. Notification behaviour
# ===========================================================================

# Send a "service started" card on startup.
NOTIFY_STARTUP=true

# Minimum gap between two startup messages. Guards against restart-loop spam;
# set to 0 to send on every start.
NOTIFY_STARTUP_COOLDOWN=10m

# Send a Feishu alert after repeated poll failures.
NOTIFY_ALERT_ON_ERROR=true


# ===========================================================================
# 5. Operations
# ===========================================================================

# Per-request HTTP timeout.
HTTP_TIMEOUT=20s

# State database location.
# Leave this commented out for local runs (defaults to ./state.db in the cwd).
# The container overrides it to /data/state.db via compose.yaml.
# STATE_PATH=/data/state.db

# debug | info | warn | error
LOG_LEVEL=info

# --- proxy (optional) -------------------------------------------------------
#
# v2ex.com is unreachable from many networks (DNS returns a poisoned address),
# while open.feishu.cn must be reached directly. Proxying is read from these
# standard variables, and only the V2EX/check-in clients use them - the Feishu
# client always bypasses proxies.
#
# Local container with Clash on the host -> uncomment. Use the host's address,
# NOT 127.0.0.1: inside a container that means the container itself.
#   docker: host.docker.internal     podman: host.containers.internal
# Cloud VM -> leave unset; it reaches v2ex.com directly.
#
# Host-side runs (./scripts/dry-run.sh, make run) rewrite host.docker.internal
# to 127.0.0.1 automatically via scripts/local-env.sh.
#
# HTTPS_PROXY=http://host.docker.internal:7897
# NO_PROXY=localhost,127.0.0.1


# ===========================================================================
# 6. Endpoints (advanced; defaults point at the public sites)
# ===========================================================================
# Only useful for self-hosted mirrors or tests. Leave commented out normally.
#
# V2EX_API_BASE_URL=https://www.v2ex.com/api/v2
# V2EX_WEB_BASE_URL=https://www.v2ex.com
# LIBRA_BASE_URL=https://2libra.com
