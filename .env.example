# 复制为 .env 后填写。
#
# ⚠️ 不要用 `cp .env.example .env`——如果 .env 已有内容会被静默覆盖。
#    请改用 `./scripts/init-env.sh`（已存在则拒绝覆盖，并以 0600 创建）。
#
# 本文件只是模板，可以安全地提交进仓库；真正的 .env 已被 .gitignore 忽略。

# --- required ---------------------------------------------------------------

# Personal Access Token from https://www.v2ex.com/settings/tokens
V2EX_TOKEN=

# Feishu custom bot webhook, e.g.
# https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_WEBHOOK=

# --- optional ---------------------------------------------------------------

# Bot signature secret. Leave empty if signature verification is disabled.
FEISHU_SECRET=

# How often to poll. Must be >= 5s. 60s uses ~60 of the 600 req/hour budget.
POLL_INTERVAL=60s

# --- proxy (optional) -------------------------------------------------------
#
# v2ex.com is unreachable from many networks (DNS returns a poisoned address),
# while open.feishu.cn must be reached directly. Proxying is read from these
# standard variables, and only the V2EX client uses them - the Feishu client
# always bypasses proxies.
#
# Local container with Clash on the host -> uncomment. Use the host's address,
# NOT 127.0.0.1: inside a container that means the container itself.
#   docker: host.docker.internal     podman: host.containers.internal
# Cloud VM -> leave unset; it reaches v2ex.com directly.
#
# Host-side runs (./scripts/dry-run.sh, make run) rewrite host.docker.internal
# to 127.0.0.1 automatically via scripts/local-env.sh.
#
# HTTPS_PROXY=http://host.docker.internal:7897
# NO_PROXY=localhost,127.0.0.1

# skip = record existing notifications on first run without pushing (recommended)
# push = push everything on first run
FIRST_RUN=skip

# Delete notifications on V2EX after a successful push.
MARK_READ=false

# Only push these kinds: reply, mention, thanks, other. Empty = push all.
FILTER_TYPES=

# Send a Feishu alert after repeated failures.
ALERT_ON_ERROR=true

# Send a "service started" card on startup.
STARTUP_MESSAGE=true

# Minimum gap between two startup messages. Guards against restart-loop spam;
# set to 0 to send on every start.
STARTUP_MESSAGE_COOLDOWN=10m

# Number of notification pages to walk per poll (20 entries each).
MAX_PAGES=3

# Per-request HTTP timeout.
HTTP_TIMEOUT=20s

# State database location.
# Leave this commented out for local runs (defaults to ./state.db in the cwd).
# The container overrides it to /data/state.db via compose.yaml.
# STATE_PATH=/data/state.db

# debug | info | warn | error
LOG_LEVEL=info

# --- daily check-in (optional) ---------------------------------------------
#
# One service signs in to both forums once a day and reports a single Feishu
# card. A site turns on as soon as its credential is present, so an existing
# deployment is unaffected until you fill one in.
#
# V2EX 每日登录奖励 is a web page that authenticates with the session cookie,
# NOT the API token above. Log in at https://www.v2ex.com/, then
#   F12 -> Application -> Cookies -> https://www.v2ex.com
# copy A2 (and A2O too if 2FA is enabled) into:
#   V2EX_COOKIE=A2=...; A2O=...
#
# 2libra signs in with POST /api/sign. Copy the access_token cookie, or the
# bearer token, from https://2libra.com/ (F12 -> Network):
#   LIBRA_COOKIE=access_token=...
#   # or, instead of the cookie:
#   # LIBRA_TOKEN=eyJhbGciOi...
#
# V2EX_COOKIE=
# LIBRA_COOKIE=

# Master switch. false disables the scheduler even when cookies are set.
CHECKIN_ENABLED=true

# Run once at startup as well. Guarded: a restart later the same day skips it,
# so a restart loop cannot spam the group.
CHECKIN_ON_START=false

# Local wall-clock time of the daily run, and the time zone it is expressed in.
CHECKIN_TIME=06:00
CHECKIN_TZ=Asia/Shanghai
