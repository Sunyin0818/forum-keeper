# 模板：只列需要你填的键，其余不写即默认（完整清单见 .env.reference）。
# 复制成 .env：cp -n .env.example .env && chmod 600 .env

# 飞书自定义机器人 webhook。
# https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_WEBHOOK=

# 机器人开了「签名校验」时才需要。
# FEISHU_SECRET=

# V2EX 签到：网页 /mission/daily 只认会话 Cookie，不认下面的 API Token。
# F12 -> Application -> Cookies -> https://www.v2ex.com，取 A2（2FA 账号连 A2O 一起）。
# 别整行粘贴浏览器全部 cookie：用不到的跟踪项值里含 `$`，会被 compose 当变量插值。
#   V2EX_COOKIE=A2=...; A2O=...
V2EX_COOKIE=

# 2libra 签到：取 access_token 拼成 access_token=...，或直接填裸 token。
LIBRA_COOKIE=

# V2EX 提醒（API 2.0），留空则只签到不轮询。
# Token：https://www.v2ex.com/settings/tokens
V2EX_TOKEN=

# 其余配置不写即默认，需要时从 .env.reference 拷对应行。
